{
  "root": "main",
  "elements": {
    "main": {
      "type": "Stack",
      "props": { "direction": "column", "gap": 20 },
      "children": ["title", "alerts", "metaSection", "charts"]
    },
    "title": {
      "type": "Caption",
      "props": { "text": "Analysis results" },
      "children": []
    },
    "alerts": {
      "type": "Alert",
      "props": {
        "title": "Notes",
        "message": { "$payload": "summaryAlertMessage" },
        "variant": "warning"
      },
      "children": []
    },
    "metaSection": {
      "type": "Stack",
      "props": { "direction": "column", "gap": 12 },
      "children": ["metaDivider", "metaMetrics", "summaryTable"]
    },
    "metaDivider": {
      "type": "Divider",
      "props": { "label": "Metadata" },
      "children": []
    },
    "metaMetrics": {
      "type": "MetricGrid",
      "props": { "columns": 3, "gap": 8 },
      "children": ["mRowCount", "mAccuracy", "mSurvivalRate"]
    },
    "mRowCount": {
      "type": "Metric",
      "props": { "label": "Rows", "value": { "$payload": "rowCount" } },
      "children": []
    },
    "mAccuracy": {
      "type": "Metric",
      "props": { "label": "Accuracy", "value": { "$payload": "accuracy" } },
      "children": []
    },
    "mSurvivalRate": {
      "type": "Metric",
      "props": { "label": "Survival rate", "value": { "$payload": "survivalRate" } },
      "children": []
    },
    "summaryTable": {
      "type": "Table",
      "props": {
        "caption": "Summary",
        "columns": { "$payload": "summaryTableColumns" },
        "rows": { "$payload": "summaryTableRows" }
      },
      "children": []
    },
    "charts": {
      "type": "Grid",
      "props": { "columns": 1, "gap": 16 },
      "children": ["barPlot", "histPlot"]
    },
    "barPlot": {
      "type": "BarChart",
      "props": {
        "title": "Survival rate by category",
        "labels": { "$payload": "barX" },
        "values": { "$payload": "barY" }
      },
      "children": []
    },
    "histPlot": {
      "type": "Histogram",
      "props": {
        "title": "Distribution",
        "x": { "$payload": "histX" },
        "y": { "$payload": "histY" }
      },
      "children": []
    }
  }
}
