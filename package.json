{
  "name": "agent-plot",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @agent-plot/server --filter @agent-plot/web --parallel dev",
    "dev:server": "pnpm --filter @agent-plot/server dev",
    "dev:api": "pnpm --filter @agent-plot/server dev",
    "dev:web": "pnpm --filter @agent-plot/web dev",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "pnpm run -r build",
    "typecheck": "pnpm run -r typecheck"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
